import javax.imageio.ImageIO;
import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.image.BufferedImage;
import java.io.File;
import java.io.IOException;
import java.util.ArrayList;

public class DisplayWindow extends JPanel implements MouseListener, KeyListener, ActionListener {
    private static final double accuracy = 0.0;
    private final boolean[] pressedKeys;
    private boolean visible = false;
    private final boolean gameOver;
    private final boolean isBGBlack;
    private int screen = -1; // Set to -1 initially to force the first update
    private final Timer timer;
    private final PlaySong currentSong;
    
    // Cache all your images here so you only load them ONCE
    private BufferedImage bgHome;
    private BufferedImage bgSongSelect;
    private BufferedImage bgSettings;
    private BufferedImage currentBackground;

    private final JButton resumeButton;
    private final JButton startButton;
    private final JButton settingsButton;
    private final JButton stopButton;
    private final JButton playButton;
    private final JButton returnButton;
    private final JButton exitButton;
    private final JButton blackBG;
    private final JLabel volume;
    private final JSlider volumeSlider;
    private final JFrame parentFrame;
    
    private JPanel songSelect;
    private JScrollPane songSelectWindow;
    private JPanel leftWrapper;
    private JPanel buttonPanel;

    public DisplayWindow(PlaySong currentSong, JFrame frame) {
        this.parentFrame = frame;
        this.currentSong = currentSong;
        this.isBGBlack = false;
        this.gameOver = false;
        
        setLayout(new BorderLayout());

        // 1. Pre-load images once into memory to stop disk lag
        try {
            bgHome = ImageIO.read(new File("src/pictures/m2.png"));
            bgSongSelect = ImageIO.read(new File("src/pictures/spinnin.png"));
            bgSettings = ImageIO.read(new File("src/pictures/astolfo.jpg"));
            currentBackground = bgHome;
        } catch (IOException e) {
            System.out.println("Image loading error: " + e.getMessage());
        }

        // 2. Initialize buttons
        startButton = new JButton("Start Music");
        startButton.addActionListener(e -> currentSong.playSound());
        stopButton = new JButton("Stop Music");
        stopButton.addActionListener(e -> currentSong.stopSound());
        resumeButton = new JButton("Resume Music");
        resumeButton.addActionListener(e -> currentSong.resumeSound());
        
        returnButton = new JButton("Return To Home Page");
        returnButton.addActionListener(e -> switchScreen(0));
        
        playButton = new JButton("PLAY");
        playButton.addActionListener(e -> switchScreen(1));
        
        settingsButton = new JButton("Settings");
        settingsButton.addActionListener(e -> switchScreen(3));
        
        exitButton = new JButton("Exit game");
        exitButton.addActionListener(e -> System.exit(0));

        volumeSlider = new JSlider(0, 100, 50);
        volume = new JLabel("Volume: 50%");
        volumeSlider.addChangeListener(e -> {
            int value = volumeSlider.getValue();
            volume.setText("Volume: " + value + "%");
        });

        blackBG = new JButton("Remove Background");
        blackBG.addActionListener(e -> {
            try {
                currentBackground = ImageIO.read(new File("src/pictures/black.jpg"));
                repaint();
            } catch (IOException ex) {
                ex.printStackTrace();
            }
        });

        // 3. Setup Persistent Layout Containers Once
        songSelect = new JPanel();
        songSelect.setLayout(new BoxLayout(songSelect, BoxLayout.Y_AXIS));
        for (int i = 0; i < 500; i++) {
            songSelect.add(new JLabel("Label " + i));
        }
        
        songSelectWindow = new JScrollPane(songSelect);
        songSelectWindow.setVerticalScrollBarPolicy(JScrollPane.VERTICAL_SCROLLBAR_ALWAYS);
        songSelectWindow.setPreferredSize(new Dimension(300, 500));
        
        leftWrapper = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 0));
        leftWrapper.setOpaque(false);
        leftWrapper.add(songSelectWindow);

        buttonPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT, 10, 10));
        buttonPanel.setOpaque(false);
        returnButton.setPreferredSize(new Dimension(200, 50));
        exitButton.setPreferredSize(new Dimension(200, 50));
        buttonPanel.add(returnButton);
        buttonPanel.add(exitButton);

        // 4. Initial layout bindings
        add(playButton);
        add(settingsButton);
        add(leftWrapper, BorderLayout.WEST);
        add(buttonPanel, BorderLayout.NORTH);
        
        // Add hidden background menu controls
        add(stopButton); add(startButton); add(resumeButton);
        add(volumeSlider); add(volume); add(blackBG);

        // Set initial visibility values
        hideAllComponents();
        switchScreen(0); // Safely boot into home screen

        pressedKeys = new boolean[128];
        addMouseListener(this);
        addKeyListener(this);
        setFocusable(true);
        requestFocusInWindow();
        
        timer = new Timer(10, this);
        timer.start();
    }

    // Helper method to toggle visibility safely without layout duplication
    private void hideAllComponents() {
        playButton.setVisible(false);
        settingsButton.setVisible(false);
        returnButton.setVisible(false);
        exitButton.setVisible(false);
        leftWrapper.setVisible(false);
        buttonPanel.setVisible(false);
        volumeSlider.setVisible(false);
        volume.setVisible(false);
        blackBG.setVisible(false);
        stopButton.setVisible(false);
        resumeButton.setVisible(false);
        startButton.setVisible(false);
    }

    // Handle screen transition logic separate from drawing mechanics
    private void switchScreen(int newScreen) {
        if (this.screen == newScreen) return;
        this.screen = newScreen;
        hideAllComponents();

        if (screen == 0) {
            currentBackground = bgHome;
            
            // Set up absolute parameters for landing panel buttons
            setLayout(null); 
            playButton.setBounds(1980/2 - 250, 1080/2 - 300, 500, 200);
            settingsButton.setBounds(1980/2 - 250, 1080/2, 500, 200);
            
            playButton.setVisible(true);
            settingsButton.setVisible(true);
        } 
        else if (screen == 1) {
            currentBackground = bgSongSelect;
            
            setLayout(new BorderLayout()); // Re-engage layout rules
            leftWrapper.setVisible(true);
            buttonPanel.setVisible(true);
            returnButton.setVisible(true);
            exitButton.setVisible(true);
        } 
        else if (screen == 3) {
            currentBackground = bgSettings;
            setLayout(new BorderLayout());
            
            buttonPanel.setVisible(true);
            returnButton.setVisible(true);
            volumeSlider.setVisible(true);
            volume.setVisible(true);
        }

        revalidate();
        repaint();
    }

    @Override
    public void paintComponent(Graphics g) {
        super.paintComponent(g);
        
        // Always render background safely first
        if (currentBackground != null) {
            g.drawImage(currentBackground, 0, 0, getWidth(), getHeight(), null);
        }

        // Handle custom geometric shapes/text rendering based on your view rules
        if (screen == 0) {
            g.setColor(Color.WHITE);
            g.setFont(new Font("Comic Sans MS", Font.PLAIN, 100));
            g.drawString("very good game", getWidth() / 2 - 350, 100);
        } 
        else if (screen == 2) {
            g.setColor(Color.WHITE);
            g.setFont(new Font("Arial", Font.BOLD, 16));
            g.drawString("Accuracy: " + Math.round(accuracy * 100.0) / 100.0, 50, 30);
        }
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        repaint(); // Keeps screen dynamic for animations/game loop updates
    }

    @Override
    public void keyPressed(KeyEvent e) {
        int keyCode = e.getKeyCode();
        if (keyCode >= 0 && keyCode < pressedKeys.length) {
            pressedKeys[keyCode] = true;
        }
        
        if (keyCode == KeyEvent.VK_F11) {
            parentFrame.dispose();
            if (parentFrame.isUndecorated()) {
                parentFrame.setUndecorated(false);
                parentFrame.setExtendedState(JFrame.NORMAL);
            } else {
                parentFrame.setUndecorated(true);
                parentFrame.setExtendedState(JFrame.MAXIMIZED_BOTH);
            }
            parentFrame.setVisible(true);
            requestFocusInWindow();
        }
        
        if (keyCode == KeyEvent.VK_ESCAPE) {
            visible = !visible;
            stopButton.setVisible(visible);
            resumeButton.setVisible(visible);
            startButton.setVisible(visible);
            volumeSlider.setVisible(visible);
            volume.setVisible(visible);
            blackBG.setVisible(visible);
        }
    }

    @Override
    public void keyReleased(KeyEvent e) {
        int key = e.getKeyCode();
        if (key >= 0 && key < pressedKeys.length) {
            pressedKeys[key] = false;
        }
    }

    // Retained stub methods to satisfy listener implementations
    @Override public void mouseClicked(MouseEvent e) {}
    @Override public void mousePressed(MouseEvent e) {}
    @Override public void mouseReleased(MouseEvent e) {}
    @Override public void mouseEntered(MouseEvent e) {}
    @Override public void mouseExited(MouseEvent e) {}
    @Override public void keyTyped(KeyEvent e) {}
}
